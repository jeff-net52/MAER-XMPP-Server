#!/bin/sh
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin; export PATH; umask 077
EXPECTED_SHA256=50fa7ef143e4b97f7ec528fec03a33b5f690a522c0b49f0c46e2c7540b7afc93
SOURCE=${1:-./maer-certificate-sync}
DEST_DIR=/usr/local/libexec/maerxmppserver
DEST=$DEST_DIR/certificate-sync
fail() { printf 'install-certificate-sync-root: %s\n' "$*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || fail 'must run as root'
[ -f "$SOURCE" ] && [ ! -L "$SOURCE" ] || fail 'source must be a regular non-symlink file'
actual=$(sha256sum "$SOURCE" | awk '{print $1}')
[ "$actual" = "$EXPECTED_SHA256" ] || fail 'source SHA-256 mismatch'
[ ! -e /usr/local/libexec ] || [ ! -L /usr/local/libexec ] || fail 'libexec root is a symlink'
[ ! -e "$DEST_DIR" ] || [ ! -L "$DEST_DIR" ] || fail 'destination directory is a symlink'
[ ! -e /usr/local/libexec ] || { [ -d /usr/local/libexec ] && [ ! -L /usr/local/libexec ]; } || fail 'libexec parent is unsafe'
mkdir -p /usr/local/libexec; chown root:root /usr/local/libexec; chmod go-w /usr/local/libexec
[ ! -e "$DEST" ] || [ ! -L "$DEST" ] || fail 'destination is a symlink'
mkdir -p "$DEST_DIR"; chown root:root "$DEST_DIR"; chmod 700 "$DEST_DIR"
tmp=$(mktemp "$DEST_DIR/.certificate-sync.XXXXXX") || fail 'unable to allocate destination'
cleanup() { rm -f "$tmp"; }
trap cleanup EXIT
trap 'cleanup; trap - EXIT; exit 129' HUP
trap 'cleanup; trap - EXIT; exit 130' INT
trap 'cleanup; trap - EXIT; exit 143' TERM
cp "$SOURCE" "$tmp"; chown root:root "$tmp"; chmod 700 "$tmp"
[ "$(sha256sum "$tmp" | awk '{print $1}')" = "$EXPECTED_SHA256" ] || fail 'copied SHA-256 mismatch'
mv -f "$tmp" "$DEST"; trap - EXIT HUP INT TERM
printf 'Installed root-owned helper: %s\n' "$DEST"
