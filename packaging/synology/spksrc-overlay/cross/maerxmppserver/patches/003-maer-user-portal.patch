+%%%===================================================================
+%%% Validation and crypto helpers
+%%%===================================================================
+
+normalize_username(User0) when is_binary(User0), byte_size(User0) >= 1,
+                                        byte_size(User0) =< 64 ->
+    User = misc:tolower(trim_ascii(User0)),
+    case re:run(User, <<"^[a-z0-9][a-z0-9._-]{0,63}$">>,
+                [{capture, none}]) of
+        match ->
+            case jid:nodeprep(User) of
+                User -> {ok, User};
+                _ -> error
+            end;
+        nomatch -> error
+    end;
+normalize_username(_) -> error.
+
+normalize_email(Email0) when is_binary(Email0) ->
+    Email = misc:tolower(trim_ascii(Email0)),
+    case byte_size(Email) >= 3 andalso byte_size(Email) =< 254 andalso
+         re:run(Email,
+           <<"^[a-z0-9.!#$%&'*+/=?^_{}|~-]+@[a-z0-9]"
+             "(?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9]"
+             "(?:[a-z0-9-]{0,61}[a-z0-9])?)+$">>,
+           [{capture, none}]) =:= match of
+        true -> {ok, Email};
+        false -> error
+    end;
+normalize_email(_) -> error.
+
+valid_password(Password, Confirmation) ->
+    is_binary(Password) andalso is_binary(Confirmation) andalso
+    byte_size(Password) >= 12 andalso byte_size(Password) =< 1024 andalso
+    secure_equal(Password, Confirmation) andalso
+    re:run(Password, <<"[\\x00\\r\\n]">>, [{capture, none}]) =:= nomatch.
+
+valid_bearer_token(Token) when is_binary(Token), byte_size(Token) =:= 43 ->
+    re:run(Token, <<"^[A-Za-z0-9_-]{43}$">>, [{capture, none}]) =:= match;
+valid_bearer_token(_) -> false.
+
+random_token() ->
+    base64url(crypto:strong_rand_bytes(32)).
+
+base64url(Value) ->
+    Encoded = base64:encode(Value),
+    URL1 = binary:replace(Encoded, <<"+">>, <<"-">>, [global]),
+    URL2 = binary:replace(URL1, <<"/">>, <<"_">>, [global]),
+    binary:replace(URL2, <<"=">>, <<>>, [global]).
+
+token_hash(Token) -> crypto:hash(sha256, Token).
+
+secure_equal(A, B) when is_binary(A), is_binary(B),
+                        byte_size(A) =:= byte_size(B) ->
+    crypto:hash_equals(A, B);
+secure_equal(_, _) -> false.
+
+trim_ascii(Value) ->
+    trim_ascii_right(trim_ascii_left(Value)).
+
+trim_ascii_left(<<C, Rest/binary>>) when C =:= $ ; C =:= $\t ->
+    trim_ascii_left(Rest);
+trim_ascii_left(Value) -> Value.
+
+trim_ascii_right(Value) ->
+    case Value of
+        <<Rest:(byte_size(Value) - 1)/binary, C>>
+          when byte_size(Value) > 0, (C =:= $  orelse C =:= $\t) ->
+            trim_ascii_right(Rest);
+        _ -> Value
+    end.
+
+bool_int(true) -> 1;
+bool_int(false) -> 0.
+
+int_bool(0) -> false;
+int_bool(_) -> true.
+
+null_to_undefined(null) -> undefined;
+null_to_undefined(Value) -> Value.
+
+now_seconds() -> erlang:system_time(second).
+
+session_ttl_default() -> 86400.
+
+-ifdef(TEST).
+-include_lib("eunit/include/eunit.hrl").
+
+username_validation_test() ->
+    ?assertEqual({ok, <<"alice-42">>}, normalize_username(<<" Alice-42 ">>)),
+    ?assertEqual(error, normalize_username(<<"alice@xmpp.maer.fr">>)),
+    ?assertEqual(error, normalize_username(<<"../alice">>)).
+
+email_validation_test() ->
+    ?assertEqual({ok, <<"alice@example.org">>},
+                 normalize_email(<<" Alice@Example.ORG ">>)),
+    ?assertEqual(error, normalize_email(<<"alice@example">>)),
+    ?assertEqual(error,
+                 normalize_email(<<"alice@example.org\r\nBcc:x@example.org">>)).
+
+password_policy_test() ->
+    ?assert(valid_password(<<"correct horse battery staple">>,
+                           <<"correct horse battery staple">>)),
+    ?assertNot(valid_password(<<"too-short">>, <<"too-short">>)),
+    ?assertNot(valid_password(<<"correct horse battery staple">>,
+                              <<"different horse battery staple">>)).
+
+html_escape_test() ->
+    ?assertEqual(<<"&lt;&amp;&quot;&#39;&gt;">>, html_escape(<<"<&\"'>">>)).
+
+cookie_parse_test() ->
+    Request = #request{headers = [{<<"Cookie">>,
+                                   <<"a=1; maer_portal_session=secret; b=2">>}]},
+    ?assertEqual({ok, <<"secret">>}, cookie(Request, ?SESSION_COOKIE)).
+
+content_type_is_total_test() ->
+    ?assertEqual(<<>>, content_type([])),
+    ?assertEqual(<<"application/x-www-form-urlencoded">>,
+                 content_type([{<<"Content-Type">>,
+                                <<"application/x-www-form-urlencoded; charset=UTF-8">>}])).
+
+token_shape_test() ->
+    Token = random_token(),
+    ?assertEqual(43, byte_size(Token)),
+    ?assert(valid_bearer_token(Token)).
+
+sqlite_profile_round_trip_test() ->
+    {ok, _} = application:ensure_all_started(sqlite3),
+    Dir = filename:join("/tmp", "maer-portal-" ++
+                        integer_to_list(erlang:unique_integer([positive]))),
+    ok = file:make_dir(Dir),
+    Path = list_to_binary(filename:join(Dir, "portal.sqlite")),
+    try
+        {ok, Db} = open_database(Path),
+        Sessions = ets:new(test_portal_sessions,
+                           [set, private, {keypos, #session.hash}]),
+        Preauth = ets:new(test_portal_preauth, [set, private]),
+        Rates = ets:new(test_portal_rates, [set, private]),
+        State = #state{opts = maps:from_list(mod_options(?HOST)), db = Db,
+                       db_path = Path, sessions = Sessions,
+                       preauth = Preauth, rates = Rates},
+        {ok, Profile} = update_options(
+                          <<"alice">>,
+                          #{audio => true, video => false,
+                            screen_share => true, assistance => true,
+                            password_manager => false}, State),
+        ?assertEqual(true, maps:get(audio, Profile)),
+        ?assertEqual(false, maps:get(video, Profile)),
+        ?assertEqual(true, maps:get(screen_share, Profile)),
+        {ok, SessionToken} = create_session(<<"alice">>, State),
+        SessionHash = token_hash(SessionToken),
+        {ok, <<"alice">>, _SessionProfile, false, CsrfToken} =
+            lookup_session(SessionHash, true, State),
+        ?assertEqual(ok,
+          with_authenticated_session(SessionHash, token_hash(CsrfToken), State,
+                                     fun(<<"alice">>) -> ok end)),
+        ?assertEqual(1, length(clear_cookies())),
+        Token = random_token(),
+        Hash = token_hash(Token),
+        ok = db_exec(Db,
+          <<"INSERT INTO portal_tokens "
+            "(token_hash, username, purpose, value, expires_at, created_at) "
+            "VALUES (?, ?, 'email_verify', ?, ?, ?)">>,
+          [Hash, <<"alice">>, <<"alice@example.org">>,
+           now_seconds() + 60, now_seconds()]),
+        ?assertEqual({ok, <<"alice">>, <<"alice@example.org">>},
+                     find_token(Hash, <<"email_verify">>, State)),
+        ok = sqlite3:close(Db)
+    after
+        _ = file:del_dir_r(Dir)
+    end.
+
+csrf_is_single_use_and_ip_bound_test() ->
+    Preauth = ets:new(test_preauth_security, [set, private]),
+    State = #state{preauth = Preauth},
+    Token = random_token(),
+    Hash = token_hash(Token),
+    IP = {192, 0, 2, 10},
+    ets:insert(Preauth, {Hash, IP, now_seconds() + 60}),
+    ?assertNot(consume_preauth(Hash, {192, 0, 2, 11}, State)),
+    ets:insert(Preauth, {Hash, IP, now_seconds() + 60}),
+    ?assert(consume_preauth(Hash, IP, State)),
+    ?assertNot(consume_preauth(Hash, IP, State)).
+
+-endif.
diff --git priv/maer_portal/portal.css priv/maer_portal/portal.css
new file mode 100644
index 00000000..4f80b90c
--- /dev/null
+++ priv/maer_portal/portal.css
@@ -0,0 +1,155 @@
+:root {
+  color: #172230;
+  background: #eef5f4;
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
+  font-synthesis: none;
+  line-height: 1.5;
+  --maer: #49cbc1;
+  --maer-dark: #167f79;
+  --ink: #172230;
+  --slate: #30353e;
+  --line: #d6e4e2;
+  --surface: #ffffff;
+  --muted: #5b6875;
+}
+
+* { box-sizing: border-box; }
+
+body {
+  min-height: 100vh;
+  margin: 0;
+  display: flex;
+  flex-direction: column;
+  background:
+    radial-gradient(circle at 10% -20%, rgba(73, 203, 193, .26), transparent 36rem),
+    #eef5f4;
+}
+
+.site-header {
+  min-height: 4.5rem;
+  display: flex;
+  align-items: center;
+  padding: .75rem clamp(1rem, 4vw, 3rem);
+  background: var(--slate);
+  border-bottom: .25rem solid var(--maer);
+}
+
+.site-header a { display: inline-flex; }
+.site-header img { display: block; width: auto; max-width: 15rem; height: 2.5rem; object-fit: contain; }
+
+main {
+  width: min(70rem, calc(100% - 2rem));
+  margin: 0 auto;
+  padding: clamp(2rem, 5vw, 4rem) 0;
+  flex: 1;
+}
+
+footer {
+  padding: 1.25rem;
+  color: #dcebea;
+  background: var(--slate);
+  text-align: center;
+  font-size: .875rem;
+}
+
+h1, h2 { color: var(--ink); line-height: 1.15; }
+h1 { margin: .25rem 0 1rem; font-size: clamp(1.8rem, 5vw, 2.75rem); }
+h2 { margin: 0 0 1rem; font-size: 1.25rem; }
+p { margin: .5rem 0 1.25rem; }
+a { color: #096b66; text-underline-offset: .18em; }
+
+.lead { color: var(--muted); font-size: 1.05rem; }
+.muted, .hint { color: var(--muted); }
+.hint { margin-top: .5rem; font-size: .85rem; }
+.eyebrow { margin: 0; color: var(--maer-dark); font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
+
+.card {
+  padding: clamp(1.25rem, 4vw, 2rem);
+  background: var(--surface);
+  border: 1px solid var(--line);
+  border-radius: 1.1rem;
+  box-shadow: 0 .75rem 2.5rem rgba(31, 62, 67, .08);
+}
+
+.auth-card { width: min(32rem, 100%); margin: 0 auto; }
+.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
+.preferences { margin-top: 1rem; }
+.dashboard-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
+
+form { display: grid; gap: .75rem; }
+label { font-weight: 700; }
+input[type="text"], input[type="email"], input[type="password"], input:not([type]) {
+  width: 100%;
+  min-height: 3rem;
+  padding: .7rem .85rem;
+  color: var(--ink);
+  background: #fff;
+  border: 1px solid #9db4b2;
+  border-radius: .65rem;
+  font: inherit;
+}
+
+input:focus-visible, button:focus-visible, a:focus-visible {
+  outline: .2rem solid #116f69;
+  outline-offset: .2rem;
+}
+
+.jid-input { display: flex; align-items: center; background: #f7fbfa; border-radius: .65rem; }
+.jid-input input { border-radius: .65rem 0 0 .65rem; }
+.jid-input span { padding: 0 .75rem; color: #47545f; font-size: .9rem; white-space: nowrap; }
+
+button, .button-link {
+  min-height: 2.8rem;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: .7rem 1rem;
+  border: 0;
+  border-radius: .65rem;
+  font: inherit;
+  font-weight: 800;
+  cursor: pointer;
+}
+
+button.primary, .button-link { color: #0b2927; background: var(--maer); text-decoration: none; }
+button.primary:hover, .button-link:hover { background: #61d7ce; }
+button.quiet { color: #27363e; background: #dfecea; }
+button:disabled { cursor: not-allowed; filter: grayscale(.6); opacity: .55; }
+
+.notice, .status { padding: .8rem 1rem; border-radius: .7rem; }
+.notice { margin-bottom: 1rem; color: #073d39; background: #cef2ee; border-left: .3rem solid var(--maer-dark); }
+.status { background: #eff4f4; }
+.status.success { color: #165b33; background: #e5f6eb; }
+.status.pending { color: #724d03; background: #fff3d6; }
+.status.neutral { color: #44515b; }
+
+.toggle {
+  min-height: 4.5rem;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1rem;
+  padding: .8rem 0;
+  border-top: 1px solid var(--line);
+  cursor: pointer;
+}
+
+.toggle small { display: block; margin-top: .2rem; color: var(--muted); font-weight: 400; }
+.toggle input { position: absolute; opacity: 0; pointer-events: none; }
+.switch { width: 3.1rem; height: 1.75rem; flex: 0 0 auto; position: relative; background: #879593; border-radius: 2rem; transition: background .15s ease; }
+.switch::after { content: ""; width: 1.3rem; height: 1.3rem; position: absolute; top: .225rem; left: .25rem; background: #fff; border-radius: 50%; box-shadow: 0 .1rem .25rem rgba(0, 0, 0, .25); transition: transform .15s ease; }
+.toggle input:checked + .switch { background: var(--maer-dark); }
+.toggle input:checked + .switch::after { transform: translateX(1.3rem); }
+.toggle input:focus-visible + .switch { outline: .2rem solid #116f69; outline-offset: .2rem; }
+
+@media (max-width: 45rem) {
+  .grid { grid-template-columns: 1fr; }
+  .dashboard-head { flex-direction: column; }
+  .jid-input { display: block; background: transparent; }
+  .jid-input input { border-radius: .65rem; }
+  .jid-input span { display: block; padding: .35rem 0 0; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
+}
diff --git priv/maer_portal/portal.js priv/maer_portal/portal.js
new file mode 100644
index 00000000..f207c5ec
--- /dev/null
+++ priv/maer_portal/portal.js
@@ -0,0 +1,25 @@
+(() => {
+  "use strict";
+
+  const form = document.querySelector("[data-fragment-form]");
+  if (!form) return;
+
+  const token = window.location.hash.slice(1);
+  const input = form.querySelector("[data-fragment-token]");
+  const submit = form.querySelector("[data-fragment-submit]");
+  const status = form.querySelector("[data-fragment-status]");
+  const valid = /^[A-Za-z0-9_-]{43}$/.test(token);
+
+  history.replaceState(null, "", window.location.pathname);
+  if (valid) {
+    input.value = token;
+    submit.disabled = false;
+    status.textContent = "Lien prêt. Vous pouvez confirmer.";
+    status.className = "status success";
+  } else {
+    input.value = "";
+    submit.disabled = true;
+    status.textContent = "Le lien ne contient pas de jeton valide.";
+    status.className = "status pending";
+  }
+})();
