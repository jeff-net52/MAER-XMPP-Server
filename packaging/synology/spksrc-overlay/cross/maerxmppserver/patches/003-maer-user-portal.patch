+feature_toggle(Name, Label, Description, Checked) ->
+    [<<"<label class=\"toggle\"><span><strong>">>, html_escape(Label),
+     <<"</strong><small>">>, html_escape(Description),
+     <<"</small></span><input type=\"checkbox\" name=\"">>, html_escape(Name),
+     <<"\"">>, case Checked of true -> <<" checked">>; false -> <<>> end,
+     <<"><span class=\"switch\" aria-hidden=\"true\"></span></label>">>].
+
+html_escape(Value) when is_binary(Value) ->
+    V1 = binary:replace(Value, <<"&">>, <<"&amp;">>, [global]),
+    V2 = binary:replace(V1, <<"<">>, <<"&lt;">>, [global]),
+    V3 = binary:replace(V2, <<">">>, <<"&gt;">>, [global]),
+    V4 = binary:replace(V3, <<"\"">>, <<"&quot;">>, [global]),
+    binary:replace(V4, <<"'">>, <<"&#39;">>, [global]).
